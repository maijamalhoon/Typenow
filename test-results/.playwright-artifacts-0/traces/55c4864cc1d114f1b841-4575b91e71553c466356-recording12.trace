{"type":"before","callId":"dzhn@1035","startTime":43005.627,"class":"Frame","method":"evaluateExpression","params":{"expression":"async sampleCount => {\n      const typingInput = document.querySelector(\"#typing-capture-input\");\n      const typingText = document.querySelector(\".typing-text\");\n      if (!typingInput || !typingText) throw new Error(\"Typing input or display is unavailable.\");\n      const commitLatencies = [];\n      const nextFrameLatencies = [];\n      for (let index = 0; index < sampleCount; index += 1) {\n        var _current$textContent;\n        const expectedIndex = Number(typingText.dataset.currentIndex) + 1;\n        const current = typingText.querySelector(\".typing-character--current\");\n        if (!current) throw new Error(\"The current typing character is unavailable.\");\n        const character = current.textContent === \"\\u00a0\" ? \" \" : (_current$textContent = current.textContent) !== null && _current$textContent !== void 0 ? _current$textContent : \"\";\n        const code = character === \" \" ? \"Space\" : `Key${character.toUpperCase()}`;\n        typingInput.dispatchEvent(new KeyboardEvent(\"keydown\", {\n          bubbles: true,\n          code,\n          key: character\n        }));\n        typingInput.dispatchEvent(new InputEvent(\"beforeinput\", {\n          bubbles: true,\n          cancelable: true,\n          data: character,\n          inputType: \"insertText\"\n        }));\n        await new Promise(resolve => {\n          const waitForCommit = () => {\n            if (typingText.dataset.commitIndex === String(expectedIndex)) {\n              resolve();\n            } else {\n              requestAnimationFrame(waitForCommit);\n            }\n          };\n          requestAnimationFrame(waitForCommit);\n        });\n        commitLatencies.push(Number(typingText.dataset.lastCommitMs));\n        await new Promise(resolve => {\n          const waitForPaint = () => {\n            if (typingText.dataset.painte